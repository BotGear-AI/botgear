# Optional override for the dev-server's REST API proxy target. Leave unset —
# vite.config.ts auto-detects whether apps/botgear/ssl/cert.pem exists (the
# backend generates it on first boot since ssl_enabled defaults to True) and
# picks https:// or http:// to match. Only set this if you're pointing the
# UI at a differently-configured backend (e.g. ssl explicitly disabled, or a
# non-default port).
# VITE_API_URL=https://localhost:8998
